# ── Nevermined ─────────────────────────────────────────────────────────────
# API key from https://nevermined.app
NVM_API_KEY=your_nevermined_api_key

# "live" for production, "sandbox" for testing (defaults to "live")
NVM_ENV=live

# ── x402 / Wallet signing ──────────────────────────────────────────────────
# Private key of the Solana wallet that will sign x402 payments (base58-encoded)
WALLET_PRIVATE_KEY=your_base58_encoded_solana_private_key

# ── Chain ──────────────────────────────────────────────────────────────────
# Exposed to the client-side (read-only display)
NEXT_PUBLIC_CHAIN=solana
